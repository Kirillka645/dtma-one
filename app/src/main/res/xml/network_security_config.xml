<?xml version="1.0" encoding="utf-8"?>
<!-- Standard system CAs only. No user CA trust, no cleartext for app traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
